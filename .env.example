# Root Level Environment Variables Reference
# Matches file: .env.example

# ==============================================================================
# BACKEND (Flask API) CONFIGURATIONS
# ==============================================================================
# Obtain from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-never-share-this
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-used-for-verifying-tokens

# Gmail SMTP Authentication
# Generate an App Password in your Google Account security settings
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Flask API Port (Local dev default: 5000)
FLASK_ENV=development
PORT=5000


# ==============================================================================
# FRONTEND (Next.js App Router) CONFIGURATIONS
# ==============================================================================
# Obtain from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-safe-for-client-side
