# Next.js Frontend Environment Variables Template
# Matches file: frontend/.env.example

# Supabase Public Configurations
# Obtain these from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-safe-for-client-side
