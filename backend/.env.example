# Flask Backend Environment Variables Template
# Matches file: backend/.env.example

# Supabase Configurations
# Obtain these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-never-share-this
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-used-for-verifying-tokens

# Gmail SMTP Authentication
# Generate an App Password in your Google Account settings
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Flask Configurations
FLASK_ENV=development
PORT=5000
